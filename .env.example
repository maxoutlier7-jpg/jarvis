# ============================================
# Configuração do Jarvis
# ============================================

# Google Gemini (recomendado - mais inteligente)
# Pegue em: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (extremamente rápido)
# Pegue em: https://console.groq.com/keys
GROQ_API_KEY=

# Provedor padrão: gemini ou groq
DEFAULT_PROVIDER=gemini

# Modelo Gemini (opcional)
GEMINI_MODEL=gemini-2.0-flash

# Modelo Groq (opcional)
GROQ_MODEL=llama-3.3-70b-versatile
