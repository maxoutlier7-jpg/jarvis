# Jarvis — copie este arquivo para .env e preencha somente as chaves que utilizar.
# Nunca coloque uma API key no código ou envie o arquivo .env ao Git.

# Google Gemini API: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq API: https://console.groq.com/keys
GROQ_API_KEY=

# Provedor inicial: gemini ou groq. Falhas nunca trocam o provider automaticamente.
DEFAULT_PROVIDER=gemini

# IDs verificados nas documentações oficiais em 05/10/2026.
# Model fallback só é tentado no mesmo provider; se necessário, personalize a lista.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b

# Memória de conversa (contagem é arredondada para manter pares completos)
MEMORY_MAX_MESSAGES=30

# Orçamento diário de tokens; 0 = sem limite. Uso persistido em UTC.
TOKENS_PER_DAY=200000
USAGE_FILE=data/usage.json

# Saída e contexto
MAX_OUTPUT_TOKENS=1024
CONTEXT_TOKEN_BUDGET=2000

# Cache em memória: validade em horas e limite de respostas; 0 desativa.
CACHE_TTL_HOURS=24
CACHE_MAX_ENTRIES=256

# Repetições apenas em erros transitórios (backoff exponencial com jitter).
# Quota diária/autenticação/modelos inexistentes não geram retries inúteis.
MAX_RETRIES=2
RETRY_BASE_SECONDS=1.0

# Máximo de ciclos modelo→ferramenta→resultado→modelo por resposta.
MAX_TOOL_ROUNDS=4
